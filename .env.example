# CareSync AI — Environment Variables Example
# Copy this file to .env.local and fill in the values from your Supabase Project Settings > API.
# NEVER commit .env.local or expose SUPABASE_SERVICE_ROLE_KEY to client code or version control.

# -----------------------------------------------------------------------------
# Client-Safe / Public Variables (Exposed to the browser via NEXT_PUBLIC_ prefix)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Server-Only Secrets (NEVER expose to the browser or prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
